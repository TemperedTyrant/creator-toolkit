@page "/Announcements/{id:guid}/PublishDiscord"
@model TemperedTyrant.CreatorToolkit.Web.Pages.Announcements.PublishDiscordModel
@using TemperedTyrant.CreatorToolkit.Core.Announcements
@using TemperedTyrant.CreatorToolkit.Infrastructure.Discord
@using TemperedTyrant.CreatorToolkit.Web.Announcements
<script src="/js/discord-member-search.js" type="module"></script>
@{
    ViewData["Title"] = "Publish to Discord";
    var guildChoices = Model.Context?.Destinations
        .Where(value => value.ConnectionId == Model.ConnectionId && value.Enabled)
        .GroupBy(value => value.GuildId)
        .Select(value => value.First())
        .ToArray() ?? [];
    var channelChoices = Model.Context?.Destinations
        .Where(value => value.ConnectionId == Model.ConnectionId && value.GuildId == Model.GuildId && value.Enabled)
        .ToArray() ?? [];
    var selectedChannels = channelChoices
        .Where(value => Model.DestinationIds.Contains(value.Id))
        .Select(value => $"#{value.ChannelName}")
        .ToArray();
    var visibleMemberIds = Model.MemberResults.Select(value => value.UserId).ToHashSet(StringComparer.Ordinal);
    var mediaInputs = Model.Context?.Media.Select(value => new AnnouncementMediaEditInput
    {
        Id = value.Id,
        Revision = value.Revision,
        SortOrder = value.SortOrder,
        ContentType = value.ContentType,
        ByteLength = value.ByteLength,
        AltText = value.AltText,
        IsSpoiler = value.IsSpoiler,
        Presentation = value.Presentation,
    }).ToArray() ?? [];
    var composer = new AnnouncementComposerViewModel(
        Model.Context?.AnnouncementTitle ?? string.Empty,
        Model.MessageContent ?? string.Empty,
        mediaInputs,
        ShowTitle: false,
        AllowUploads: false,
        Model.Id,
        Model.SelectedMediaIds);
}
@if (Model.Context is not null)
{
    <header class="page-heading split-heading">
        <div>
            <h1>Publish to Discord</h1>
            <p class="lede"><strong>@Model.Context.AnnouncementTitle</strong> <span class="muted">— internal title, not sent</span></p>
        </div>
        <a asp-page="/Announcements/Details" asp-route-id="@Model.Id">Cancel</a>
    </header>
    <section class="notice">
        <p>Reviewing and confirming creates an encrypted durable snapshot. Discord delivery continues after browser disconnection and restart.</p>
    </section>

    @if (Model.Discovery is null)
    {
        <section class="card compact-selector">
            <h2>Destination</h2>
            <form method="get">
                <input type="hidden" name="id" value="@Model.Id">
                <label asp-for="ConnectionId">Discord connection</label>
                <select asp-for="ConnectionId">
                    <option value="">Choose a connection</option>
                    @foreach (var connection in Model.Context.Connections.Where(value => value.Enabled))
                    {
                        <option value="@connection.Id">@connection.Name (@connection.BotUsername)</option>
                    }
                </select>
                @if (Model.ConnectionId != Guid.Empty)
                {
                    <label asp-for="GuildId">Server</label>
                    <select asp-for="GuildId">
                        <option value="">Choose a server</option>
                        @foreach (var guild in guildChoices)
                        {
                            <option value="@guild.GuildId">@guild.GuildName</option>
                        }
                    </select>
                }
                <button type="submit">Open composer</button>
            </form>
        </section>
    }
    else
    {
        <form method="post"
              asp-page-handler="Publish"
              id="discord-publication-form"
              data-member-search-url="@Url.Page("/Announcements/PublishDiscord", "SearchMembers", new { id = Model.Id })">
            <input type="hidden" asp-for="Id">
            <input type="hidden" asp-for="ConnectionId">
            <input type="hidden" asp-for="GuildId">
            <input type="hidden" asp-for="SubmissionId">
            <input type="hidden" asp-for="AnnouncementRevision">
            <input type="hidden" asp-for="ReviewComplete">
            <input type="hidden" asp-for="ReviewToken">
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

            <details class="card compact-selector" open>
                <summary><strong>Destination:</strong> @Model.Context.Connections.Single(value => value.Id == Model.ConnectionId).Name / @Model.Discovery.Guild.Name / @(selectedChannels.Length == 0 ? "choose channels" : string.Join(", ", selectedChannels))</summary>
                <fieldset>
                    <legend>Select up to 10 saved channels in this server</legend>
                    @foreach (var destination in channelChoices)
                    {
                        <label class="choice"><input type="checkbox" name="DestinationIds" value="@destination.Id" checked="@(Model.DestinationIds.Contains(destination.Id))"> #@destination.ChannelName</label>
                    }
                </fieldset>
            </details>

            <section class="card">
                <h2>Message</h2>
                <partial name="_AnnouncementComposer" model="composer" />
                <p class="field-help">The internal title above is not inserted into this message. Discord-compatible Markdown is sent as source; this editor is not an exact Discord preview.</p>
            </section>

            <details class="card composer-option-panel" data-mention-panel>
                <summary>Mentions <span class="muted">— disabled unless explicitly selected</span></summary>
                <p>Typed mention syntax alone cannot authorize a notification. Selected IDs are validated against the live server before enqueueing.</p>
                @if (Model.CanUseMassMentions)
                {
                    <div class="notice"><strong>High impact:</strong> mass mentions require effective Discord permission in every selected channel.</div>
                    <label class="choice"><input asp-for="MentionEveryone"> Include @@everyone</label>
                    <label class="choice"><input asp-for="MentionHere"> Include @@here</label>
                    <label class="choice"><input asp-for="MassMentionConfirmed"> Confirm this high-impact mass mention</label>
                }
                <details>
                    <summary>Select roles (maximum 25)</summary>
                    @foreach (var role in Model.Discovery.Roles.Where(value => value.Id != Model.Discovery.Guild.Id))
                    {
                        bool permitted = role.Mentionable || (Model.CanUseMassMentions && Model.Discovery.Channels.All(value => value.CanMentionEveryone));
                        if (permitted)
                        {
                            <label class="choice"><input type="checkbox" name="RoleIds" value="@role.Id" checked="@(Model.RoleIds.Contains(role.Id))"> @role.Name <span class="muted">@role.Id</span></label>
                        }
                    }
                </details>
                <label asp-for="MemberQuery">Search members (2–100 characters)</label>
                <div class="inline-form">
                    <input asp-for="MemberQuery" minlength="2" maxlength="100" autocomplete="off">
                    <button class="secondary" id="member-search-button" type="submit" asp-page-handler="SearchMembers">Search</button>
                </div>
                <span asp-validation-for="MemberQuery"></span>
                <fieldset id="member-search-results" aria-busy="false">
                    <legend>Member search results</legend>
                    <div id="member-search-result-items">
                    @foreach (var member in Model.MemberResults)
                    {
                        <label class="choice"><input class="member-result-choice" type="checkbox" name="UserIds" value="@member.UserId" checked="@(Model.UserIds.Contains(member.UserId))"> @member.DisplayName <span class="muted">@member.UserId</span></label>
                    }
                    </div>
                </fieldset>
                <div id="selected-discord-members">
                @foreach (var selectedUserId in Model.UserIds.Distinct(StringComparer.Ordinal).Where(value => !visibleMemberIds.Contains(value)))
                {
                    <input type="hidden" name="UserIds" value="@selectedUserId">
                    <span class="mention-chip">Selected user @selectedUserId</span>
                }
                </div>
                <label asp-for="ManualUserId">Discord user ID fallback</label>
                <input asp-for="ManualUserId" inputmode="numeric" maxlength="20">
                <p id="member-search-status" class="muted" role="status" aria-live="polite">Search terms are sent to Discord but are not persisted or logged.</p>
            </details>

            <details class="card composer-option-panel" data-advanced-panel>
                <summary>More presentation options</summary>
                <fieldset>
                    <legend>Presentation</legend>
                    <label class="choice"><input type="radio" asp-for="Mode" value="@DiscordMessageMode.Plain"> Plain message</label>
                    <label class="choice"><input type="radio" asp-for="Mode" value="@DiscordMessageMode.Embed"> Rich embed</label>
                </fieldset>
                <label class="choice"><input asp-for="ShowLinkPreviews"> Show automatic link previews for a plain message</label>
                <p class="field-help">In rich-embed mode, the main message becomes the embed description. No title or additional message is added automatically.</p>
                <label asp-for="EmbedTitleUrl">HTTPS title link</label><input asp-for="EmbedTitleUrl" type="url" maxlength="2048">
                <label asp-for="EmbedColor">Color (hex)</label><input asp-for="EmbedColor" placeholder="#74c7a5" maxlength="7">
                <label asp-for="EmbedFooter">Footer</label><input asp-for="EmbedFooter" maxlength="2048">
                <label asp-for="EmbedImageUrl">HTTPS external image URL</label><input asp-for="EmbedImageUrl" type="url" maxlength="2048">
                <label asp-for="EmbedThumbnailUrl">HTTPS thumbnail URL</label><input asp-for="EmbedThumbnailUrl" type="url" maxlength="2048">
                <p class="field-help">Creator Toolkit passes accepted HTTPS URLs to Discord and never fetches them.</p>
            </details>

            <section class="card review-summary">
                <h2>Review and publish</h2>
                <dl class="status-list">
                    <dt>Internal title (not sent)</dt><dd>@Model.Context.AnnouncementTitle</dd>
                    <dt>Announcement revision</dt><dd>@Model.AnnouncementRevision</dd>
                    <dt>Destinations</dt><dd>@(selectedChannels.Length == 0 ? "None selected" : string.Join(", ", selectedChannels))</dd>
                    <dt>Presentation</dt><dd>@Model.Mode</dd>
                    <dt>Stored images</dt><dd>@Model.SelectedMediaIds.Count selected</dd>
                    @if (Model.ReviewImageFormat is not null)
                    {
                        <dt>Publication-only image</dt><dd>Validated @Model.ReviewImageFormat image · @Model.ReviewImageByteSize bytes · @(Model.ImageSpoiler ? "Spoiler" : "Standard")</dd>
                    }
                    <dt>Mass mention</dt><dd>@(Model.MentionEveryone ? "@@everyone" : Model.MentionHere ? "@@here" : "None")</dd>
                </dl>
                @if (!Model.ReviewComplete)
                {
                    <button type="submit" asp-page-handler="Review">Review publication</button>
                }
                else
                {
                    <div class="notice" role="status">The server validated this immutable review. Confirming queues it; this request does not call Discord.</div>
                    <label class="choice"><input asp-for="FinalConfirmation" required> Queue this reviewed publication for Discord delivery.</label>
                    <span asp-validation-for="FinalConfirmation" class="field-validation-error"></span>
                    <button type="submit">Queue Discord publication</button>
                    <button class="secondary" type="submit" asp-page-handler="Review">Validate review again</button>
                }
            </section>
        </form>
    }
}
