@page "/Announcements/New"
@model TemperedTyrant.CreatorToolkit.Web.Pages.Announcements.NewModel
@using TemperedTyrant.CreatorToolkit.Web.Announcements
@{
    ViewData["Title"] = "Create announcement";
}
<header class="page-heading">
    <h1>Create announcement</h1>
    <p class="lede">Write a Markdown-backed message and optionally attach encrypted draft images.</p>
</header>
<form method="post" enctype="multipart/form-data" class="card editor-form">
    <input asp-for="AnnouncementId" type="hidden">
    <div asp-validation-summary="ModelOnly"></div>
    @await Html.PartialAsync("_AnnouncementComposer", new AnnouncementComposerViewModel(Model.Title, Model.MessageContent, [], true, true))
    <div class="actions">
        <button type="submit">Save draft</button>
        <a class="button secondary" asp-page="/Announcements/Index">Cancel</a>
    </div>
</form>
