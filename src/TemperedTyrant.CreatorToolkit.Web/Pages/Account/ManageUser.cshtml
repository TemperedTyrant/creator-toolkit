@page
@model TemperedTyrant.CreatorToolkit.Web.Pages.Account.ManageUserModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage account</title>
</head>
<body>
    <main>
        <h1>Manage account</h1>
        @if (Model.Target is not null)
        {
            <p>@Model.Target.DisplayName (@Model.Target.UserName)</p>
            <p>Current role: @Model.Target.Role</p>
            <p>Status: @(Model.Target.IsActivated ? (Model.Target.IsEnabled ? "Active" : "Disabled") : "Pending")</p>
        }
        @if (Model.OneTimeActivationLink is not null)
        {
            <section>
                <h2>Replacement activation link</h2>
                <p>Copy this link now. It cannot be retrieved later.</p>
                <p><a href="@Model.OneTimeActivationLink">@Model.OneTimeActivationLink</a></p>
            </section>
        }
        <div asp-validation-summary="ModelOnly"></div>
        @if (Model.Target is not null)
        {
            <form method="post" asp-page-handler="Role">
                <input asp-for="UserId" type="hidden">
                <input asp-for="ExpectedConcurrencyStamp" type="hidden">
                <label asp-for="NewRole">Role</label>
                <select asp-for="NewRole">
                    @foreach (string role in Model.Target.AssignableRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <button type="submit">Change role</button>
            </form>
            @if (!Model.Target.IsActivated)
            {
                <form method="post" asp-page-handler="RegenerateActivation">
                    <input asp-for="UserId" type="hidden">
                    <input asp-for="ExpectedConcurrencyStamp" type="hidden">
                    <button type="submit">Regenerate activation link</button>
                </form>
            }
            @if (Model.Target.IsEnabled)
            {
                <form method="post" asp-page-handler="Disable">
                    <input asp-for="UserId" type="hidden">
                    <input asp-for="ExpectedConcurrencyStamp" type="hidden">
                    <button type="submit">Disable account</button>
                </form>
            }
            <form method="post" asp-page-handler="Delete">
                <input asp-for="UserId" type="hidden">
                <input asp-for="ExpectedConcurrencyStamp" type="hidden">
                <button type="submit">Delete account</button>
            </form>
        }
    </main>
</body>
</html>
