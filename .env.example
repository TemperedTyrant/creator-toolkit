# Safe local defaults used by compose.yaml.
CREATOR_TOOLKIT_HOST_BIND=127.0.0.1
CREATOR_TOOLKIT_HOST_PORT=8080

# Optional canonical URL. HTTPS is required except for a loopback URL.
# CREATOR_TOOLKIT_PUBLIC_URL=https://example.invalid

# Optional comma-separated addresses/CIDR networks for a reverse proxy.
# Leave both unset unless a proxy is actually in use.
# CREATOR_TOOLKIT_TRUSTED_PROXIES=replace-with-proxy-address
# CREATOR_TOOLKIT_TRUSTED_NETWORKS=replace-with-proxy-network
